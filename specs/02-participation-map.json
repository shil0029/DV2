{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536371",
      "titleColor": "#21374b",
      "domain": false,
      "ticks": false,
      "gridColor": "#d7e0e6",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#21374b",
      "titleColor": "#21374b",
      "orient": "bottom",
      "titleFontWeight": 500,
      "padding": 12
    },
    "style": {
      "cell": {
        "stroke": null
      }
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "description": "Percentage of adults who fished at least once in 2020, by state or combined NSW/ACT region.",
  "layer": [
    {
      "data": {
        "url": "data/australia.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.region",
          "from": {
            "data": {
              "values": [
                {
                  "region": "VIC",
                  "name": "Victoria",
                  "year": 2020,
                  "participation_percent": 19,
                  "source_ref": "state-participation"
                },
                {
                  "region": "NSW/ACT",
                  "name": "New South Wales and ACT",
                  "year": 2020,
                  "participation_percent": 20.1,
                  "source_ref": "state-participation"
                },
                {
                  "region": "SA",
                  "name": "South Australia",
                  "year": 2020,
                  "participation_percent": 21.3,
                  "source_ref": "state-participation"
                },
                {
                  "region": "TAS",
                  "name": "Tasmania",
                  "year": 2020,
                  "participation_percent": 21.4,
                  "source_ref": "state-participation"
                },
                {
                  "region": "QLD",
                  "name": "Queensland",
                  "year": 2020,
                  "participation_percent": 22.9,
                  "source_ref": "state-participation"
                },
                {
                  "region": "WA",
                  "name": "Western Australia",
                  "year": 2020,
                  "participation_percent": 24.4,
                  "source_ref": "state-participation"
                },
                {
                  "region": "NT",
                  "name": "Northern Territory",
                  "year": 2020,
                  "participation_percent": 35.1,
                  "source_ref": "state-participation"
                }
              ]
            },
            "key": "region",
            "fields": [
              "participation_percent"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f6f7f8",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "participation_percent",
          "type": "quantitative",
          "title": "Adults who fished (%)",
          "scale": {
            "domain": [
              15,
              36
            ],
            "range": [
              "#e1ebf2",
              "#305c80"
            ]
          },
          "legend": {
            "format": ".0f",
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "field": "properties.region",
            "title": "Survey region"
          },
          {
            "field": "participation_percent",
            "title": "Adults who fished in 2020 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "region": "VIC",
            "name": "Victoria",
            "year": 2020,
            "participation_percent": 19,
            "source_ref": "state-participation",
            "lon": 144,
            "lat": -37,
            "label": "VIC\n19.0%"
          },
          {
            "region": "NSW/ACT",
            "name": "New South Wales and ACT",
            "year": 2020,
            "participation_percent": 20.1,
            "source_ref": "state-participation",
            "lon": 147,
            "lat": -33,
            "label": "NSW/ACT\n20.1%"
          },
          {
            "region": "SA",
            "name": "South Australia",
            "year": 2020,
            "participation_percent": 21.3,
            "source_ref": "state-participation",
            "lon": 135,
            "lat": -30,
            "label": "SA\n21.3%"
          },
          {
            "region": "TAS",
            "name": "Tasmania",
            "year": 2020,
            "participation_percent": 21.4,
            "source_ref": "state-participation",
            "lon": 147,
            "lat": -42,
            "label": "TAS\n21.4%"
          },
          {
            "region": "QLD",
            "name": "Queensland",
            "year": 2020,
            "participation_percent": 22.9,
            "source_ref": "state-participation",
            "lon": 145,
            "lat": -23,
            "label": "QLD\n22.9%"
          },
          {
            "region": "WA",
            "name": "Western Australia",
            "year": 2020,
            "participation_percent": 24.4,
            "source_ref": "state-participation",
            "lon": 121,
            "lat": -26,
            "label": "WA\n24.4%"
          },
          {
            "region": "NT",
            "name": "Northern Territory",
            "year": 2020,
            "participation_percent": 35.1,
            "source_ref": "state-participation",
            "lon": 133,
            "lat": -20,
            "label": "NT\n35.1%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14,
        "dy": -5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.region === 'NT'",
            "value": "#ffffff"
          },
          "value": "#21374b"
        }
      }
    }
  ]
}
