{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536371",
      "titleColor": "#21374b",
      "domain": false,
      "ticks": false,
      "gridColor": "#d7e0e6",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#21374b",
      "titleColor": "#21374b",
      "orient": "bottom",
      "titleFontWeight": 500,
      "padding": 12
    },
    "style": {
      "cell": {
        "stroke": null
      }
    }
  },
  "padding": {
    "left": 55,
    "right": 95,
    "top": 25,
    "bottom": 35
  },
  "data": {
    "values": [
      {
        "age_group": "18–29",
        "year": 2018,
        "participation_percent": 22.3,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "18–29",
        "year": 2020,
        "participation_percent": 24.8,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "30–44",
        "year": 2018,
        "participation_percent": 26.6,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "30–44",
        "year": 2020,
        "participation_percent": 20.6,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "45–64",
        "year": 2018,
        "participation_percent": 20.1,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "45–64",
        "year": 2020,
        "participation_percent": 18,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "65+",
        "year": 2018,
        "participation_percent": 15.5,
        "source_ref": "age-gender-participation"
      },
      {
        "age_group": "65+",
        "year": 2020,
        "participation_percent": 15.1,
        "source_ref": "age-gender-participation"
      }
    ]
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontWeight": 700
      }
    },
    "y": {
      "field": "participation_percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          12,
          29
        ]
      },
      "axis": {
        "title": "Adults who fished (%)",
        "values": [
          15,
          20,
          25
        ]
      }
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "18–29",
          "30–44",
          "45–64",
          "65+"
        ],
        "range": [
          "#386f98",
          "#ad5738",
          "#725a7a",
          "#856720"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "age_group"
    },
    "tooltip": [
      {
        "field": "age_group",
        "title": "Age group"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "participation_percent",
        "title": "Participation (%)",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2018"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "participation_percent",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2020"
        },
        {
          "calculate": "datum.age_group + ' · ' + format(datum.participation_percent, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "Ages 30–44: −6 percentage points"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -10
        },
        "color": {
          "value": "#ad5738"
        },
        "text": {
          "field": "label"
        },
        "tooltip": null
      }
    }
  ]
}
