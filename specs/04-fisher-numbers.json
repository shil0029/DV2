{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536371",
      "titleColor": "#21374b",
      "domain": false,
      "ticks": false,
      "gridColor": "#d7e0e6",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#21374b",
      "titleColor": "#21374b",
      "orient": "bottom",
      "titleFontWeight": 500,
      "padding": 12
    },
    "style": {
      "cell": {
        "stroke": null
      }
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dce4eb",
        "stroke": "#f6f7f8",
        "strokeWidth": 1.3
      }
    },
    {
      "data": {
        "values": [
          {
            "region": "VIC",
            "year": 2018,
            "participation_percent": 16.42,
            "adult_population_june_2019": 5119957,
            "estimated_fishers": 840900,
            "source_ref": "state-fishers-2018",
            "lon": 144,
            "lat": -37
          },
          {
            "region": "NSW/ACT",
            "year": 2018,
            "participation_percent": 19.55,
            "adult_population_june_2019": 6616409,
            "estimated_fishers": 1293700,
            "source_ref": "state-fishers-2018",
            "lon": 147,
