            "source_ref": "state-fishers-2018",
            "lon": 145,
            "lat": -23
          },
          {
            "region": "WA",
            "year": 2018,
            "participation_percent": 25.78,
            "adult_population_june_2019": 2053135,
            "estimated_fishers": 529400,
            "source_ref": "state-fishers-2018",
            "lon": 121,
            "lat": -26
          },
          {
            "region": "NT",
