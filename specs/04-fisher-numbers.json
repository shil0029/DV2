      },
      "mark": {
        "type": "circle",
        "color": "#386f98",
        "opacity": 0.7,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "estimated_fishers",
          "type": "quantitative",
          "title": "Adult fishers (2018)",
          "scale": {
            "range": [
              0,
              4500
            ],
            "zero": true
          },
          "legend": {
            "values": [
              100000,
              500000,
              1000000
            ],
            "format": ".2s"
          }
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Survey region"
          },
          {
            "field": "estimated_fishers",
            "title": "Estimated adult fishers in 2018",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
