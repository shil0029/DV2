        ]
      },
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#21374b",
        "dy": -8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code"
        }
      }
    }
