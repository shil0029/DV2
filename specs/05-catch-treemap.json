    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "field": "colour"
          },
          "stroke": {
            "value": "#f6f7f8"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "tooltip": {
            "signal": "{Species:datum.species, 'Estimated catches':format(datum.total, ','), 'Year':'2023/24'}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#21374b"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2-7"
          },
          "text": {
            "field": "species"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontWeight": {
            "value": 600
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#ffffff"
          },
          "limit": {
            "signal": "datum.x1-datum.x0-12"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0>70 && datum.y1-datum.y0>35 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2+12"
          },
          "text": {
            "signal": "datum.total >= 1000000 ? format(datum.total/1000000, '.2f')+'m' : format(datum.total/1000, '.0f')+'k'"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#ffffff"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0>70 && datum.y1-datum.y0>45 ? 1 : 0"
          }
        }
      }
    }
  ]
