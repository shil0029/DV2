{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 570,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#697d7c",
      "titleColor": "#173e45",
      "domain": false,
      "ticks": false,
      "gridColor": "#dce2d9",
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#173e45",
      "titleColor": "#173e45",
      "orient": "bottom",
      "titleFontWeight": 500,
      "padding": 12
    },
    "style": {
      "cell": {
        "stroke": null
      }
    }
  },
  "padding": {
    "left": 8,
    "right": 12,
    "top": 5,
    "bottom": 10
  },
  "data": {
    "url": "data/nsw.json",
    "format": {
      "type": "json",
      "property": "catch"
    }
  },
  "mark": {
    "type": "rect",
    "stroke": "#faf9f2",
    "strokeWidth": 3,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        "2017/18",
        "2019/20",
        "2021/22",
        "2023/24"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "orient": "top",
        "labelFontWeight": 600
      }
    },
    "y": {
      "field": "species",
      "type": "nominal",
      "sort": [
        "Bream",
        "Dusky Flathead",
        "Snapper",
        "Murray Cod",
        "Tailor",
        "Sand Whiting",
        "Sand Flathead",
        "Luderick",
        "Yellowtail Kingfish",
        "Rainbow Trout",
        "Australian Bass",
        "Yabbies",
        "Blue Swimmer Crab",
        "Brown Trout",
        "Golden Perch",
        "Australian Salmon",
        "Mulloway",
        "Leatherjacket",
        "Silver Trevally",
        "Grey Morwong"
      ],
      "axis": {
        "title": null,
        "labelLimit": 145
      }
    },
    "color": {
      "field": "release_share",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ],
        "range": [
          "#f1e4c5",
          "#0b787e"
        ]
      },
      "title": "Share released",
      "legend": {
        "format": ".0%",
        "gradientLength": 200
      }
    },
    "tooltip": [
      {
        "field": "species",
        "title": "Species / group"
      },
      {
        "field": "year",
        "title": "Survey"
      },
      {
        "field": "release_share",
        "title": "Released",
        "format": ".1%"
      },
      {
        "field": "released",
        "title": "Estimated released",
        "format": ",.0f"
      },
      {
        "field": "total",
        "title": "Estimated caught",
        "format": ",.0f"
      }
    ]
  }
}
