  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "signal": "'M'+(xLeft+9)+','+(datum.start*unit+datum.rank*10)+' C'+(xLeft+(xRight-xLeft)*0.5)+','+(datum.start*unit+datum.rank*10)+' '+(xLeft+(xRight-xLeft)*0.5)+','+(datum.end*unit+(datum.fate==='Released'?50:0))+' '+xRight+','+(datum.end*unit+(datum.fate==='Released'?50:0))"
          },
          "stroke": {
            "field": "colour"
          },
          "strokeWidth": {
            "signal": "datum.value*unit"
          },
          "strokeOpacity": {
            "value": 0.42
          },
          "fill": {
            "value": null
          },
          "tooltip": {
            "signal": "{Species:datum.species,Outcome:datum.fate,'Estimated individuals':format(datum.value, ',')}"
          }
        },
        "hover": {
          "strokeOpacity": {
            "value": 0.8
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side==='source'?xLeft:xRight"
          },
          "width": {
            "value": 9
          },
          "y": {
            "signal": "datum.start*unit+(datum.side==='source'?datum.rank*10:datum.rank*50)"
          },
          "height": {
            "signal": "(datum.end-datum.start)*unit"
          },
          "fill": {
            "signal": "datum.side==='source'?'#21374b':datum.name==='Kept'?'#ad5738':'#386f98'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side==='source'?xLeft-9:xRight+17"
          },
          "y": {
            "signal": "(datum.start+datum.end)/2*unit+(datum.side==='source'?datum.rank*10:datum.rank*50)"
          },
          "text": {
            "field": "name"
          },
          "align": {
            "signal": "datum.side==='source'?'right':'left'"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 500
          },
          "fill": {
            "value": "#21374b"
          },
          "limit": {
            "signal": "datum.side==='source'?xLeft-12:85"
          }
        }
      }
    }
  ]
